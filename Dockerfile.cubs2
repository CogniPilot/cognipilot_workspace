# syntax=docker/dockerfile:1.7

# The release workflow builds linux/amd64 because the CUBS2 native/Zephyr
# toolchain is currently qualified on x86-64. Pin both Nix and devenv so the
# bootstrap layer cannot drift underneath a workspace release tag.
FROM nixos/nix:2.32.8@sha256:72a13b0f42e3cc515945aa4250b772381d93c96d4bf93aa950b5c68defdab1dd

ARG DEVENV_VERSION=2.1.2

RUN printf '%s\n' \
      'experimental-features = nix-command flakes' \
      'accept-flake-config = true' \
      >> /etc/nix/nix.conf \
    && nix profile install --accept-flake-config \
      "github:cachix/devenv/v${DEVENV_VERSION}"

WORKDIR /workspace
ENV COGNIPILOT_WORKSPACE_ROOT=/workspace

COPY . .

# config.git.root and several component tools expect a worktree. The release
# source intentionally excludes the publishing repository's .git directory.
RUN git init -q -b main \
    && /root/.nix-profile/bin/devenv shell -- bash -euo pipefail -c \
      'ws profile cubs2; ws restore workspace.lock.json; ws mode local; ws build'

ENTRYPOINT ["/root/.nix-profile/bin/devenv", "shell", "--"]
CMD ["bash"]
