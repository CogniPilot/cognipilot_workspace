{
  # Devenv's execIfModified implementation hashes every matched directory
  # recursively. Keep this contract file-only: broad directory patterns such
  # as `**/*` make ignored mutable outputs part of the cache key and turn a
  # warm no-op into another build. Shared presets use this list by default so
  # ordinary projects need no cache declarations of their own.
  inputs = [
    ".envrc"
    ".cargo/config"
    ".clang-format"
    ".clang-tidy"
    ".dockerignore"
    ".gitignore"
    ".gitmodules"
    ".nixignore"
    ".npmrc"
    "CMakeLists.txt"
    "Cargo.lock"
    "Cargo.toml"
    "Dockerfile"
    "Doxyfile"
    "Kconfig"
    "LICENSE"
    "Makefile"
    "VERSION"
    "configure"
    "configure.ac"
    "flake.lock"
    "flake.nix"
    "meson.build"
    "meson_options.txt"
    "package-lock.json"
    "package.json"
    "pnpm-lock.yaml"
    "pyproject.toml"
    "rust-toolchain"
    "rust-toolchain.toml"
    "west.yml"
    "yarn.lock"
    "**/CMakeLists.txt"
    "**/.cargo/config"
    "**/.clang-format"
    "**/.clang-tidy"
    "**/.dockerignore"
    "**/.gitignore"
    "**/.gitmodules"
    "**/.nixignore"
    "**/.npmrc"
    "**/Dockerfile"
    "**/Kconfig"
    "**/Kconfig.*"
    "**/LICENSE"
    "**/Makefile"
    "**/VERSION"
    "**/configure"
    "**/configure.ac"
    "**/meson.build"
    "**/meson_options.txt"
    "**/*.S"
    "**/*.asm"
    "**/*.bash"
    "**/*.bin"
    "**/*.c"
    "**/*.cc"
    "**/*.cfg"
    "**/*.cmake"
    "**/*.conf"
    "**/*.cpp"
    "**/*.csv"
    "**/*.css"
    "**/*.cxx"
    "**/*.dts"
    "**/*.dtsi"
    "**/*.fbs"
    "**/*.gif"
    "**/*.h"
    "**/*.hh"
    "**/*.hpp"
    "**/*.html"
    "**/*.hxx"
    "**/*.ico"
    "**/*.ini"
    "**/*.jpeg"
    "**/*.jpg"
    "**/*.js"
    "**/*.json"
    "**/*.ld"
    "**/*.lock"
    "**/*.md"
    "**/*.mjs"
    "**/*.mk"
    "**/*.mo"
    "**/*.nix"
    "**/*.overlay"
    "**/*.png"
    "**/*.proto"
    "**/*.py"
    "**/*.rs"
    "**/*.scss"
    "**/*.sh"
    "**/*.svelte"
    "**/*.svg"
    "**/*.toml"
    "**/*.ts"
    "**/*.tsx"
    "**/*.txt"
    "**/*.woff"
