#!/usr/bin/env bash
set -euo pipefail

root="${COGNIPILOT_WORKSPACE_ROOT:-$(git rev-parse --show-toplevel)}"
manifest="${COGNIPILOT_REPO_MANIFEST:-}"
result_root="$root/dev/benchmarks"
thresholds="$root/nix/workspace-benchmark-thresholds.json"
check_thresholds=false
declare -a requested_targets=()

usage() {
	cat <<'EOF'
Usage: ws benchmark [--check] [COMPONENT ...]

Records one isolated cold build followed immediately by one warm build for
every requested component. With no components, benchmarks every declared local
build target. Missing optional repositories are recorded as unavailable.

Cold means fresh workspace build/devel/task state while shared Nix, Cargo, npm,
and source-download caches remain available. Existing developer artifacts are
never deleted or modified by the benchmark state manager.
EOF
}

while [[ $# -gt 0 ]]; do
	case "$1" in
	--check)
		check_thresholds=true
		;;
	-h | --help)
		usage
		exit 0
		;;
	--*)
		printf 'unknown benchmark option: %s\n' "$1" >&2
		usage >&2
		exit 2
		;;
	*) requested_targets+=("$1") ;;
	esac
	shift
done

[[ -r "$manifest" ]] || {
	printf 'repository manifest is unavailable; enter devenv shell first\n' >&2
	exit 1
}

if ((${#requested_targets[@]} == 0)); then
	mapfile -t requested_targets < <(
		jq -r '
      .components
      | to_entries[]
      | select(.value.tasks.local.build == true)
      | .key
    ' "$manifest" | sort
	)
fi

mkdir -p "$result_root/logs"
run_id="$(date -u +%Y%m%dT%H%M%SZ)"
run_log_root="$result_root/logs/$run_id"
mkdir -p "$run_log_root"
scratch="$(mktemp -d "${TMPDIR:-/tmp}/cognipilot-benchmark.XXXXXX")"
entries="$scratch/entries.jsonl"
trap 'rm -rf "$scratch"' EXIT

elapsed_seconds() {
	local start_ns="$1"
	local end_ns="$2"
	python - "$start_ns" "$end_ns" <<'PY'
import sys

print(f"{(int(sys.argv[2]) - int(sys.argv[1])) / 1_000_000_000:.3f}")
PY
}

benchmark_phase() {
	local target="$1"
	local phase="$2"
	local state_root="$3"
	local log_file="$4"
	local start_ns end_ns status duration

	printf '  %-5s ' "$phase" >&2
	start_ns="$(date +%s%N)"
	set +e
	env \
		COGNIPILOT_STATE_ROOT_OVERRIDE="$state_root" \
		DEVENV_TUI=false \
		NO_COLOR=1 \
		"$root/scripts/ws" build "$target" >"$log_file" 2>&1
	status=$?
	set -e
	end_ns="$(date +%s%N)"
	duration="$(elapsed_seconds "$start_ns" "$end_ns")"
	printf '%7ss  %s\n' "$duration" "$([[ $status -eq 0 ]] && printf ok || printf 'failed (%d)' "$status")" >&2
	printf '%s %s\n' "$duration" "$status"
}

for target in "${requested_targets[@]}"; do
	if ! component_json="$(jq -ce --arg target "$target" '.components[$target]' "$manifest")"; then
		printf 'unknown workspace component: %s\n' "$target" >&2
		exit 2
	fi
	component_path="$(jq -r '.path' <<<"$component_json")"
	printf '%s\n' "$target" >&2
	if [[ ! -d "$root/$component_path" ]]; then
		jq -nc --arg target "$target" --arg path "$component_path" '
        {key: $target, value: {status: "unavailable", path: $path}}
      ' >>"$entries"
		printf '  unavailable (%s)\n' "$component_path" >&2
		continue
	fi

	target_state="$scratch/state/$target"
	cold_log="$run_log_root/$target-cold.log"
	warm_log="$run_log_root/$target-warm.log"
	read -r cold_seconds cold_status < <(
		benchmark_phase "$target" cold "$target_state" "$cold_log"
	)
	if [[ "$cold_status" -eq 0 ]]; then
		read -r warm_seconds warm_status < <(
			benchmark_phase "$target" warm "$target_state" "$warm_log"
		)
	else
		warm_seconds=null
		warm_status=-1
		printf '  warm  skipped after cold failure\n' >&2
	fi

	status=ok
	if [[ "$cold_status" -ne 0 || "$warm_status" -ne 0 ]]; then
		status=failed
	fi
	jq -nc \
		--arg target "$target" \
		--arg path "$component_path" \
		--arg status "$status" \
		--arg cold_log "logs/$run_id/$target-cold.log" \
		--arg warm_log "logs/$run_id/$target-warm.log" \
		--argjson cold_seconds "$cold_seconds" \
		--argjson cold_status "$cold_status" \
		--argjson warm_seconds "$warm_seconds" \
		--argjson warm_status "$warm_status" '
      {
        key: $target,
        value: {
          status: $status,
          path: $path,
          cold_seconds: $cold_seconds,
          warm_seconds: $warm_seconds,
          cold_exit_code: $cold_status,
          warm_exit_code: $warm_status,
          cold_log: $cold_log,
          warm_log: $warm_log
        }
      }
    ' >>"$entries"
	rm -rf "$target_state"
done

result="$result_root/$run_id.json"
root_revision="$(git -C "$root" rev-parse HEAD 2>/dev/null || printf unknown)"
jq -s \
	--arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
	--arg root_revision "$root_revision" \
	--arg hostname "$(hostname)" '
  {
    schema: 1,
    created_at: $created_at,
    root_revision: $root_revision,
    hostname: $hostname,
    definition: {
      cold: "fresh workspace build/devel/task state; shared package and download caches retained",
      warm: "immediate unchanged repeat using the cold build outputs"
    },
    targets: (map({(.key): .value}) | add // {})
  }
' "$entries" >"$result"
ln -sfn "$(basename "$result")" "$result_root/latest.json"

printf 'benchmark results: %s\n' "$result"
jq -r '
  .targets
  | to_entries[]
  | if .value.status == "unavailable" then
      "\(.key)\tunavailable\t-"
    else
      "\(.key)\t\(.value.cold_seconds)s\t\(if .value.warm_seconds == null then "-" else "\(.value.warm_seconds)s" end)"
    end
' "$result" | column -t -s $'\t'

if [[ "$check_thresholds" == true ]]; then
	[[ -r "$thresholds" ]] || {
		printf 'benchmark thresholds are unavailable: %s\n' "$thresholds" >&2
		exit 2
	}
	check_result="$(jq -c --slurpfile thresholds "$thresholds" '
    [
      .targets
      | to_entries[]
      | . as $target
      | ($thresholds[0].warm_max_seconds[.key] // null) as $limit
      | if .value.status == "unavailable" then
          empty
        elif .value.status != "ok" then
          {target: .key, reason: "build failed"}
        elif $limit == null then
          {target: .key, reason: "no warm-build budget is established"}
        elif .value.warm_seconds > $limit then
          {
            target: .key,
            reason: "warm-build budget exceeded",
            actual_seconds: .value.warm_seconds,
            limit_seconds: $limit
          }
        else
          empty
        end
    ]
  ' "$result")"
	if ! jq -e 'length == 0' >/dev/null <<<"$check_result"; then
		jq -r '
      .[]
      | if .actual_seconds then
          "benchmark check failed: \(.target): \(.reason) (\(.actual_seconds)s > \(.limit_seconds)s)"
        else
          "benchmark check failed: \(.target): \(.reason)"
        end
    ' <<<"$check_result" >&2
		exit 1
	fi
	printf 'all available warm builds are within their budgets\n'
fi
