#!/usr/bin/env bash
set -euo pipefail

root="${COGNIPILOT_WORKSPACE_ROOT:-$(git rev-parse --show-toplevel)}"
cd "$root"

actionlint
nixfmt --check devenv.nix launch/*.nix nix/*.nix nix/components/default.nix
deadnix --fail devenv.nix launch nix
statix check devenv.nix
statix check launch
statix check nix
shell_scripts=(
	completions/ws.bash
	scripts/lint-workspace
	scripts/benchmark-workspace
	scripts/render-workspace-dockerfile
	scripts/west-workspace
	scripts/workspace-cmake-build
	scripts/workspace-flake-ref
	scripts/workspace-release-environment
	scripts/workspace-task-cache
	scripts/ws
)
shfmt -d "${shell_scripts[@]}"
shellcheck "${shell_scripts[@]}"
ruff check scripts/*.py tests
ruff format --check scripts/*.py tests
