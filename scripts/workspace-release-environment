#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
	printf 'usage: workspace-release-environment COMMAND [ARG ...]\n' >&2
	exit 2
fi

repository="$(git rev-parse --show-toplevel 2>/dev/null)" || {
	printf 'release tasks must run inside a Git component worktree\n' >&2
	exit 1
}

if [[ -n "$(git -C "$repository" status --porcelain --untracked-files=normal)" ]]; then
	printf 'release tasks require a clean component worktree: %s\n' "$repository" >&2
	printf 'commit, stash, or remove local changes before building a release\n' >&2
	exit 1
fi

revision="$(git -C "$repository" rev-parse --verify HEAD)"
devel_root="${COGNIPILOT_DEVEL_ROOT:-}"

sanitize_search_path() {
	local name="$1"
	local value="${!name-}"
	local entry joined=""
	local -a entries=()

	[[ -n "$devel_root" && -n "$value" ]] || return 0
	IFS=: read -r -a entries <<<"$value"
	for entry in "${entries[@]}"; do
		if [[ "$entry" == "$devel_root" || "$entry" == "$devel_root/"* ]]; then
			continue
		fi
		if [[ -n "$joined" ]]; then
			joined+=":"
		fi
		joined+="$entry"
	done
	printf -v "$name" '%s' "$joined"
	export "${name?}"
}

for search_path in \
	PATH \
	PYTHONPATH \
	NODE_PATH \
	CMAKE_PREFIX_PATH \
	PKG_CONFIG_PATH \
	RUST_PATH; do
	sanitize_search_path "$search_path"
done

# These are development-only overrides. Release components must resolve their
# dependencies from their own checked-in locks and package definitions.
unset \
	COGNIPILOT_DEVEL_ROOT \
	CUBS2_RUMOCA_PYTHON \
	CUBS2_SYNAPSE_C_ROOT \
	RDD2_RUMOCA_EXECUTABLE \
	FETCHCONTENT_SOURCE_DIR_SYNAPSE_FBS_C

if [[ -n "$devel_root" ]]; then
	while IFS='=' read -r name value; do
		if [[ "$value" == *"$devel_root"* ]]; then
			printf 'release environment still references devel through %s\n' "$name" >&2
			exit 1
		fi
	done < <(env)
fi

export COGNIPILOT_DEPENDENCY_MODE=release
export COGNIPILOT_COMPONENT_REVISION="$revision"

exec "$@"
