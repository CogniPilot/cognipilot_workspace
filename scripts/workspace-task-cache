#!/usr/bin/env bash
set -euo pipefail

usage() {
	printf 'usage: workspace-task-cache check|record KEY REPOSITORY [repo:PATH|build:PATH|devel:PATH|release:PATH ...]\n' >&2
	exit 2
}

[[ $# -ge 3 ]] || usage
action="$1"
key="$2"
repository="$3"
shift 3

root="${COGNIPILOT_WORKSPACE_ROOT:?COGNIPILOT_WORKSPACE_ROOT is not set}"
build_root="${COGNIPILOT_BUILD_ROOT:?COGNIPILOT_BUILD_ROOT is not set}"
devel_root="${COGNIPILOT_DEVEL_ROOT:?COGNIPILOT_DEVEL_ROOT is not set}"
release_root="${COGNIPILOT_RELEASE_RESULTS:?COGNIPILOT_RELEASE_RESULTS is not set}"
cache_dir="$build_root/task-cache"
stamp="$cache_dir/${key//:/_}.sha256"
repositories=("$repository")
while IFS= read -r input_repository; do
	[[ -n "$input_repository" ]] && repositories+=("$input_repository")
done <<<"${COGNIPILOT_TASK_CACHE_INPUT_REPOSITORIES:-}"

resolve_output() {
	case "$1" in
	repo:*) printf '%s/%s\n' "$repository" "${1#repo:}" ;;
	build:*) printf '%s/%s\n' "$build_root" "${1#build:}" ;;
	devel:*) printf '%s/%s\n' "$devel_root" "${1#devel:}" ;;
	release:*) printf '%s/%s\n' "$release_root" "${1#release:}" ;;
	*)
		printf 'invalid task-cache output specification: %s\n' "$1" >&2
		return 2
		;;
	esac
}

fingerprint_repository_metadata() {
	local current_repository="$1"

	# One stat process handles the complete Git-visible source set. Nanosecond
	# mtime/ctime plus device/inode make an ordinary write, chmod, replacement,
	# or link retarget invalidate the fast path even if size is unchanged.
	(
		cd -- "$current_repository"
		git ls-files --cached --others --exclude-standard -z |
			sort -z |
			xargs -0 -r stat \
				--printf='source\0%n\0%f\0%s\0%d\0%i\0%y\0%z\0' --
	)
}

fingerprint_repository_content() {
	local current_repository="$1"
	local path

	source_paths() {
		git -C "$current_repository" ls-files --cached --others --exclude-standard -z | sort -z
	}

	{
		printf 'repository\0%s\0' "$current_repository"
		# Emit path and symlink/index metadata first. Regular file contents are
		# hashed below in batches, avoiding one sha256sum process per file.
		source_paths |
			while IFS= read -r -d '' path; do
				printf '%s\0' "$path"
				if [[ -L "$current_repository/$path" ]]; then
					printf 'symlink\0%s' "$(readlink -- "$current_repository/$path")"
				elif [[ ! -f "$current_repository/$path" ]]; then
					git -C "$current_repository" ls-files --stage -- "$path" | tr -d '\n'
				fi
				printf '\0'
			done

		source_paths |
			while IFS= read -r -d '' path; do
				if [[ -f "$current_repository/$path" && ! -L "$current_repository/$path" ]]; then
					printf '%s\0' "$path"
				fi
			done |
			(
				cd "$current_repository"
				xargs -0 -r sha256sum --
			)
	}
}

fingerprint_input_metadata() {
	{
		printf 'workspace-task-cache-input-metadata-v4\0'
		# These files are small and define cache semantics, so hash them even on
		# the fast path instead of depending on filesystem metadata alone.
		for recipe in \
			"$root/nix/components/default.nix" \
			"$root/nix/tasks.nix" \
			"$root/scripts/workspace-task-cache"; do
			printf '%s\0' "${recipe#"$root"/}"
			sha256sum -- "$recipe" | cut -d' ' -f1 | tr -d '\n'
			printf '\0'
		done
		for input_repository in "${repositories[@]}"; do
			printf 'repository\0%s\0' "$input_repository"
			fingerprint_repository_metadata "$input_repository"
		done
	} | sha256sum | cut -d' ' -f1
}

fingerprint_input_content() {
	{
		printf 'workspace-task-cache-input-content-v4\0'
		for recipe in \
			"$root/nix/components/default.nix" \
			"$root/nix/tasks.nix" \
			"$root/scripts/workspace-task-cache"; do
			printf '%s\0' "${recipe#"$root"/}"
			sha256sum -- "$recipe" | cut -d' ' -f1 | tr -d '\n'
			printf '\0'
		done
		for input_repository in "${repositories[@]}"; do
			fingerprint_repository_content "$input_repository"
		done
	} | sha256sum | cut -d' ' -f1
}

fingerprint_tree_metadata() {
	local path="$1"
	(
		cd -- "$path"
		# GNU find emits the whole tree without one stat process per entry. The
		# record includes name, kind, mode, size, device/inode, nanosecond
		# mtime/ctime, and link target. A normal content write cannot preserve
		# ctime, even when a tool restores mtime.
		LC_ALL=C find -P . -printf '%P\034%y\034%m\034%s\034%D\034%i\034%T@\034%C@\034%l\0' |
			sort -z
	)
}

fingerprint_output_metadata() {
	local output="$1"
	local path
	path="$(resolve_output "$output")"
	[[ -e "$path" || -L "$path" ]] || return 1

	printf 'output\0%s\0' "$output"
	if [[ -L "$path" ]]; then
		stat --printf='symlink\0%f\0%s\0%d\0%i\0%y\0%z\0' -- "$path"
		printf 'target\0%s\0' "$(readlink -- "$path")"
		[[ -e "$path" ]] || return 1
		if [[ -d "$path" ]]; then
			fingerprint_tree_metadata "$path"
		else
			stat -L --printf='referent\0%f\0%s\0%d\0%i\0%y\0%z\0' -- "$path"
		fi
	elif [[ -d "$path" ]]; then
		fingerprint_tree_metadata "$path"
	else
		stat --printf='entry\0%f\0%s\0%d\0%i\0%y\0%z\0' -- "$path"
	fi
}

fingerprint_output_metadata_set() {
	{
		printf 'workspace-task-cache-output-metadata-v4\0'
		for output in "$@"; do
			fingerprint_output_metadata "$output"
		done
	} | sha256sum | cut -d' ' -f1
}

fingerprint_regular_file() {
	local path="$1"
	printf 'regular\0%s\0' "$(stat -Lc '%a' -- "$path")"
	sha256sum -- "$path" | cut -d' ' -f1 | tr -d '\n'
	printf '\0'
}

fingerprint_tree() {
	local path="$1"
	(
		cd -- "$path"
		printf 'tree\0'

		# A canonical tar stream proves names, entry kinds, modes, link targets,
		# sizes, and file contents in one traversal. Normalizing timestamps and
		# ownership keeps metadata that is not part of the artifact contract
		# from causing misses. GNU tar does not follow links by default.
		tar \
			--sort=name \
			--mtime=@0 \
			--owner=0 \
			--group=0 \
			--numeric-owner \
			--format=gnu \
			-cf - .
	)
}

fingerprint_output() {
	local output="$1"
	local path
	path="$(resolve_output "$output")"
	[[ -e "$path" || -L "$path" ]] || return 1

	printf 'output\0%s\0' "$output"
	if [[ -L "$path" ]]; then
		printf 'symlink\0%s\0' "$(readlink -- "$path")"
		# A broken exported link is never a valid artifact. For a live link,
		# include the target's contents as well as the link identity.
		[[ -e "$path" ]] || return 1
		if [[ -f "$path" ]]; then
			fingerprint_regular_file "$path"
		elif [[ -d "$path" ]]; then
			fingerprint_tree "$path"
		else
			printf 'other\0%s\0%s\0' \
				"$(stat -Lc '%F' -- "$path")" \
				"$(stat -Lc '%a' -- "$path")"
		fi
	elif [[ -f "$path" ]]; then
		fingerprint_regular_file "$path"
	elif [[ -d "$path" ]]; then
		fingerprint_tree "$path"
	else
		printf 'other\0%s\0%s\0' \
			"$(stat -c '%F' -- "$path")" \
			"$(stat -c '%a' -- "$path")"
	fi
}

fingerprint_output_content_set() {
	{
		printf 'workspace-task-cache-output-content-v4\0'
		for output in "$@"; do
			fingerprint_output "$output"
		done
	} | sha256sum | cut -d' ' -f1
}

case "$action" in
check)
	[[ -f "$stamp" ]] || exit 1
	mapfile -t recorded <"$stamp"
	[[ ${#recorded[@]} -eq 5 ]] || exit 1
	[[ "${recorded[0]}" == "workspace-task-cache-v4" ]] || exit 1
	current_input_metadata="$(fingerprint_input_metadata)"
	current_output_metadata="$(fingerprint_output_metadata_set "$@")" || exit 1
	[[ "${recorded[1]}" == "$current_input_metadata" ]]
	[[ "${recorded[3]}" == "$current_output_metadata" ]]
	;;
record)
	for output in "$@"; do
		path="$(resolve_output "$output")"
		if [[ ! -e "$path" && ! -L "$path" ]]; then
			printf 'task output was not created: %s\n' "$path" >&2
			exit 1
		fi
	done
	input_metadata_before="$(fingerprint_input_metadata)"
	output_metadata_before="$(fingerprint_output_metadata_set "$@")" || exit 1
	input_content="$(fingerprint_input_content)"
	output_content="$(fingerprint_output_content_set "$@")" || {
		printf 'task output is invalid or contains a broken link\n' >&2
		exit 1
	}
	input_metadata_after="$(fingerprint_input_metadata)"
	output_metadata_after="$(fingerprint_output_metadata_set "$@")" || exit 1
	if [[ "$input_metadata_before" != "$input_metadata_after" ||
		"$output_metadata_before" != "$output_metadata_after" ]]; then
		printf 'task inputs or outputs changed while publishing the cache stamp\n' >&2
		exit 1
	fi
	mkdir -p "$cache_dir"
	temporary="$(mktemp "$cache_dir/.${key//:/_}.XXXXXX")"
	trap 'rm -f "$temporary"' EXIT
	{
		printf 'workspace-task-cache-v4\n'
		printf '%s\n' "$input_metadata_after"
		printf '%s\n' "$input_content"
		printf '%s\n' "$output_metadata_after"
		printf '%s\n' "$output_content"
	} >"$temporary"
	mv "$temporary" "$stamp"
	trap - EXIT
	;;
*) usage ;;
esac
