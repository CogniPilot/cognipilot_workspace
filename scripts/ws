#!/usr/bin/env bash
set -euo pipefail

root="${COGNIPILOT_WORKSPACE_ROOT:-$(git rev-parse --show-toplevel)}"
state="${COGNIPILOT_STATE_ROOT_OVERRIDE:-${COGNIPILOT_WORKSPACE_STATE:-${DEVENV_STATE:-$root/.devenv/state}}}"
manifest="${COGNIPILOT_REPO_MANIFEST:-}"
launch_manifest="${COGNIPILOT_LAUNCH_MANIFEST:-}"
mode_file="$state/workspace-mode"
profile_file="$state/workspace-profile"
protocol_file="$state/git-protocol"

mkdir -p "$state"

declare -a cleanup_paths=()

register_cleanup() {
	cleanup_paths+=("$1")
}

cleanup() {
	local path
	for path in "${cleanup_paths[@]}"; do
		[[ -n "$path" ]] && rm -rf -- "$path"
	done
}

trap cleanup EXIT

# Color only interactive output. NO_COLOR is the standard opt-out, while
# CLICOLOR_FORCE makes snapshots/tests able to exercise the colored path.
if [[ -z "${NO_COLOR+x}" ]] &&
	{ [[ -t 1 && "${TERM:-dumb}" != "dumb" ]] ||
		[[ "${CLICOLOR_FORCE:-0}" != "0" ]]; }; then
	C_RESET=$'\033[0m'
	C_BOLD=$'\033[1m'
	C_DIM=$'\033[2m'
	C_RED=$'\033[31m'
	C_GREEN=$'\033[32m'
	C_YELLOW=$'\033[33m'
	C_BLUE=$'\033[34m'
	C_MAGENTA=$'\033[35m'
	C_CYAN=$'\033[36m'
else
	C_RESET=''
	C_BOLD=''
	C_DIM=''
	C_RED=''
	C_GREEN=''
	C_YELLOW=''
	C_BLUE=''
	C_MAGENTA=''
	C_CYAN=''
fi

component_is_active() {
	local name="$1"
	local profile
	while IFS= read -r profile; do
		if jq -e --arg profile "$profile" --arg name "$name" \
			'.profiles[$profile] | index($name) != null' "$manifest" >/dev/null; then
			return 0
		fi
	done < <(current_profiles)
	return 1
}

state_write() {
	local destination="$1"
	local value="$2"
	local temporary
	temporary="$(mktemp "$state/.state.XXXXXX")"
	register_cleanup "$temporary"
	printf '%s\n' "$value" >"$temporary"
	mv "$temporary" "$destination"
}

print_worktree_status() {
	local path="$1"
	local line code color
	while IFS= read -r line; do
		[[ -n "$line" ]] || continue
		code="${line:0:2}"
		case "$code" in
		'??' | 'A ' | ' A') color="$C_GREEN" ;;
		*D* | *U*) color="$C_RED" ;;
		*) color="$C_YELLOW" ;;
		esac
		printf '  %b%s%b\n' "$color" "$line" "$C_RESET"
	done < <(git -C "$path" status --short)
}

require_manifest() {
	if [[ -z "$manifest" || ! -r "$manifest" ]]; then
		printf 'repository manifest is unavailable; enter devenv shell first\n' >&2
		exit 1
	fi
}

require_launch_manifest() {
	if [[ -z "$launch_manifest" || ! -r "$launch_manifest" ]]; then
		printf 'launch manifest is unavailable; enter devenv shell first\n' >&2
		exit 1
	fi
}

launch_profile_names() {
	require_launch_manifest
	jq -r '.profiles | keys[]' "$launch_manifest"
}

validate_launch_profile() {
	require_launch_manifest
	if ! jq -e --arg profile "$1" '.profiles[$profile] != null' \
		"$launch_manifest" >/dev/null; then
		printf 'unknown launch profile: %s\n' "$1" >&2
		printf 'available launch profiles: %s\n' \
			"$(jq -r '.profiles | keys | join(", ")' "$launch_manifest")" >&2
		return 2
	fi
}

launch_processes() {
	local profile process
	local -A seen_processes=()
	for profile in "$@"; do
		validate_launch_profile "$profile"
		while IFS= read -r process; do
			[[ -n "$process" && -z "${seen_processes[$process]:-}" ]] || continue
			printf '%s\n' "$process"
			seen_processes[$process]=1
		done < <(jq -r --arg profile "$profile" \
			'.profiles[$profile].processes[]' "$launch_manifest")
	done
}

validate_launch_process() {
	local requested="$1"
	shift
	local process
	while IFS= read -r process; do
		[[ "$process" == "$requested" ]] && return 0
	done < <(launch_processes "$@")
	printf 'process %s is not provided by launch profile(s): %s\n' \
		"$requested" "$(
			IFS=,
			printf '%s' "$*"
		)" >&2
	return 2
}

list_launch_profiles() {
	require_launch_manifest
	local profile description processes
	while IFS= read -r profile; do
		description="$(jq -r --arg profile "$profile" \
			'.profiles[$profile].description' "$launch_manifest")"
		processes="$(jq -r --arg profile "$profile" \
			'.profiles[$profile].processes | join(", ")' "$launch_manifest")"
		printf '%b● %s%b\n' "$C_BOLD$C_CYAN" "$profile" "$C_RESET"
		printf '  %bprocesses:%b %s\n' "$C_BLUE" "$C_RESET" "$processes"
		printf '  %s\n' "$description"
	done < <(launch_profile_names)
}

launch_workspace() {
	if [[ $# -eq 0 || ($# -eq 1 && "$1" == "list") ]]; then
		list_launch_profiles
		return
	fi

	local action="up" argument profile
	local -a profiles=() profile_args=() action_args=()
	local -A seen_profiles=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
		up | status | logs | restart | start | stop | down | wait)
			action="$1"
			shift
			action_args=("$@")
			break
			;;
		list)
			printf 'usage: ws launch list | PROFILE... [ACTION [PROCESS]]\n' >&2
			return 2
			;;
		*)
			profile="$1"
			validate_launch_profile "$profile"
			if [[ -z "${seen_profiles[$profile]:-}" ]]; then
				profiles+=("$profile")
				profile_args+=(--profile "$profile")
				seen_profiles[$profile]=1
			fi
			shift
			;;
		esac
	done

	if ((${#profiles[@]} == 0)); then
		printf 'select at least one launch profile; run: ws launch list\n' >&2
		return 2
	fi

	case "$action" in
	up)
		for argument in "${action_args[@]}"; do
			validate_launch_process "$argument" "${profiles[@]}"
		done
		cd "$root"
		exec devenv "${profile_args[@]}" up "${action_args[@]}"
		;;
	status)
		[[ ${#action_args[@]} -le 1 ]] || {
			printf 'usage: ws launch PROFILE... status [PROCESS]\n' >&2
			return 2
		}
		if ((${#action_args[@]} == 0)); then
			cd "$root"
			exec devenv "${profile_args[@]}" processes list
		fi
		validate_launch_process "${action_args[0]}" "${profiles[@]}"
		cd "$root"
		exec devenv "${profile_args[@]}" processes status "${action_args[0]}"
		;;
	logs | restart)
		[[ ${#action_args[@]} -eq 1 ]] || {
			printf 'usage: ws launch PROFILE... %s PROCESS\n' "$action" >&2
			return 2
		}
		validate_launch_process "${action_args[0]}" "${profiles[@]}"
		cd "$root"
		exec devenv "${profile_args[@]}" processes "$action" "${action_args[0]}"
		;;
	start | stop)
		[[ ${#action_args[@]} -le 1 ]] || {
			printf 'usage: ws launch PROFILE... %s [PROCESS]\n' "$action" >&2
			return 2
		}
		if ((${#action_args[@]} == 1)); then
			validate_launch_process "${action_args[0]}" "${profiles[@]}"
		fi
		cd "$root"
		exec devenv "${profile_args[@]}" processes "$action" "${action_args[@]}"
		;;
	down | wait)
		[[ ${#action_args[@]} -eq 0 ]] || {
			printf 'usage: ws launch PROFILE... %s\n' "$action" >&2
			return 2
		}
		cd "$root"
		exec devenv "${profile_args[@]}" processes "$action"
		;;
	esac
}

complete_workspace_command() {
	# Completion always passes the token currently being edited. Parse only the
	# completed words; the shell filters the candidates against that token.
	local -a words=("$@") completed=() candidates=()
	local word command action="" profile process completed_count
	completed_count=$((${#words[@]} - 1))
	if ((completed_count > 0)); then
		completed=("${words[@]:0:completed_count}")
	fi

	if ((${#completed[@]} == 0)); then
		printf '%s\n' \
			sync update commit push freeze restore mode profile build test benchmark shell \
			launch west remotes status graph banner help
		return
	fi

	command="${completed[0]}"
	case "$command" in
	launch)
		require_launch_manifest
		local -a selected_profiles=() action_args=()
		local -A selected_profile_names=() selected_process_names=()
		for word in "${completed[@]:1}"; do
			if [[ -n "$action" ]]; then
				action_args+=("$word")
				continue
			fi
			case "$word" in
			list) return ;;
			up | status | logs | restart | start | stop | down | wait)
				action="$word"
				;;
			*)
				jq -e --arg profile "$word" '.profiles[$profile] != null' \
					"$launch_manifest" >/dev/null || return
				if [[ -z "${selected_profile_names[$word]:-}" ]]; then
					selected_profiles+=("$word")
					selected_profile_names[$word]=1
				fi
				;;
			esac
		done
		if [[ -z "$action" ]]; then
			if ((${#selected_profiles[@]} == 0)); then
				candidates+=(list)
			else
				candidates+=(up status logs restart start stop down wait)
			fi
			while IFS= read -r profile; do
				[[ -z "${selected_profile_names[$profile]:-}" ]] && candidates+=("$profile")
			done < <(launch_profile_names)
			printf '%s\n' "${candidates[@]}"
			return
		fi
		case "$action" in
		up)
			for process in "${action_args[@]}"; do
				selected_process_names[$process]=1
			done
			;;
		status | logs | restart | start | stop)
			((${#action_args[@]} == 0)) || return
			;;
		*) return ;;
		esac
		while IFS= read -r process; do
			[[ -z "${selected_process_names[$process]:-}" ]] && printf '%s\n' "$process"
		done < <(launch_processes "${selected_profiles[@]}")
		;;
	profile)
		printf 'list\n'
		require_manifest
		jq -r '.profiles | keys[]' "$manifest"
		;;
	sync | update | build | test | shell)
		require_manifest
		[[ "$command" == "shell" ]] || printf 'all\n'
		jq -r '.components | keys[]' "$manifest"
		;;
	west) printf '%s\n' sync status validate path ;;
	remotes) printf '%s\n' ssh https ;;
	status) printf '%s\n' --all ;;
	esac
}

require_component() {
	require_manifest
	if ! jq -e --arg name "$1" '.components[$name] != null' "$manifest" >/dev/null; then
		printf 'unknown component: %s\n' "$1" >&2
		return 2
	fi
}

component_value() {
	local name="$1"
	local query="$2"
	require_component "$name"
	# Do not use jq -e here: valid boolean false values (optional/private) have
	# a non-zero jq truthiness status even though the query succeeded.
	jq -r --arg name "$name" ".components[\$name] | $query" "$manifest"
}

component_path() {
	printf '%s/%s\n' "$root" "$(component_value "$1" '.path')"
}

component_has_task() {
	local name="$1"
	local mode="$2"
	local kind="$3"
	[[ "$(component_value "$name" ".tasks.${mode}.${kind}")" == "true" ]]
}

devenv_profile_args() {
	local name profile
	local -A seen_profiles=()
	for name in "$@"; do
		profile="$(component_value "$name" '(.devenvProfile // empty)')"
		[[ -n "$profile" && -z "${seen_profiles[$profile]:-}" ]] || continue
		printf '%s\n%s\n' '--profile' "$profile"
		seen_profiles[$profile]=1
	done
}

require_ros_cache_trust() {
	local trusted
	trusted="$(nix config show trusted-substituters 2>/dev/null || true)"
	if [[ " $trusted " != *" https://ros.cachix.org "* ]]; then
		cat >&2 <<'EOF'
ROS 2 is selected, but https://ros.cachix.org is not a trusted Nix substituter.
Configure its trusted-substituters and trusted-public-keys entries as documented
in README.md before building; otherwise Nix would rebuild ROS Jazzy from source.
EOF
		return 1
	fi
}

component_closure_field() {
	local name="$1"
	local field="$2"
	require_component "$name"
	jq -r --arg name "$name" --arg field "$field" '
    . as $root
    | def closure($current):
        ($root.components[$current]
          // error("unknown dependency: \($current)")) as $component
        | (($component[$field] // [])[] | closure(.)), $current;
      reduce closure($name) as $component
        ([]; if index($component) then . else . + [$component] end)
      | .[]
  ' "$manifest"
}

component_closure() {
	component_closure_field "$1" dependencies
}

component_build_closure() {
	component_closure_field "$1" buildDependencies
}

declare -a targets=()
declare -A selected=()

clear_selection() {
	targets=()
	selected=()
}

add_target() {
	local name="$1"
	if [[ -z "${selected[$name]:-}" ]]; then
		selected[$name]=1
		targets+=("$name")
	fi
}

add_closure() {
	local name="$1"
	local dependency
	while IFS= read -r dependency; do
		add_target "$dependency"
	done < <(component_closure "$name")
}

add_build_closure() {
	local name="$1"
	local dependency
	while IFS= read -r dependency; do
		add_target "$dependency"
	done < <(component_build_closure "$name")
}

current_profiles() {
	if [[ -s "$profile_file" ]]; then
		cat "$profile_file"
	else
		printf 'default\n'
	fi
}

profile_label() {
	current_profiles | paste -sd+ -
}

profiles_csv() {
	current_profiles | paste -sd, -
}

validate_profile() {
	require_manifest
	if ! jq -e --arg profile "$1" '.profiles[$profile] != null' "$manifest" >/dev/null; then
		printf 'unknown workspace profile: %s\n' "$1" >&2
		printf 'available profiles: %s\n' \
			"$(jq -r '.profiles | keys | join(", ")' "$manifest")" >&2
		return 2
	fi
}

select_components() {
	local selector="$1"
	local with_dependencies="${2:-true}"
	local name
	clear_selection
	if [[ "$selector" == "all" ]]; then
		local profile
		while IFS= read -r profile; do
			validate_profile "$profile"
			while IFS= read -r name; do
				if [[ "$with_dependencies" == "true" ]]; then
					add_closure "$name"
				else
					add_target "$name"
				fi
			done < <(jq -r --arg profile "$profile" '.profiles[$profile][]' "$manifest")
		done < <(current_profiles)
		return
	fi
	require_component "$selector"
	if [[ "$with_dependencies" == "true" ]]; then
		add_closure "$selector"
	else
		add_target "$selector"
	fi
}

select_build_components() {
	local selector="$1"
	local name profile
	clear_selection
	if [[ "$selector" == "all" ]]; then
		while IFS= read -r profile; do
			validate_profile "$profile"
			while IFS= read -r name; do
				add_build_closure "$name"
			done < <(jq -r --arg profile "$profile" '.profiles[$profile][]' "$manifest")
		done < <(current_profiles)
		return
	fi
	require_component "$selector"
	add_build_closure "$selector"
}

current_mode() {
	local mode="local"
	[[ -s "$mode_file" ]] && mode="$(cat "$mode_file")"
	case "$mode" in
	local | release) printf '%s\n' "$mode" ;;
	*)
		printf 'invalid workspace mode in %s: %s\n' "$mode_file" "$mode" >&2
		printf 'repair it with: ws mode local\n' >&2
		return 1
		;;
	esac
}

current_protocol() {
	local protocol="https"
	[[ -s "$protocol_file" ]] && protocol="$(cat "$protocol_file")"
	case "$protocol" in
	ssh | https) printf '%s\n' "$protocol" ;;
	*)
		printf 'invalid Git protocol in %s: %s\n' "$protocol_file" "$protocol" >&2
		printf 'repair it with: ws remotes https\n' >&2
		return 1
		;;
	esac
}

github_urls() {
	local name="$1"
	local github
	github="$(component_value "$name" '.repo.github')"
	printf 'https://github.com/%s.git\n' "$github"
	printf 'git@github.com:%s.git\n' "$github"
}

set_push_protocol() {
	local name="$1"
	local path="$2"
	local protocol="${3:-}"
	local https_url ssh_url
	local -a urls=()
	mapfile -t urls < <(github_urls "$name")
	https_url="${urls[0]}"
	ssh_url="${urls[1]}"
	[[ -n "$protocol" ]] || protocol="$(current_protocol)"
	# Fetches stay on portable HTTPS. Do not overwrite a developer's custom
	# fetch remote after the initial clone.
	if ! git -C "$path" remote get-url origin >/dev/null 2>&1; then
		git -C "$path" remote add origin "$https_url"
	fi
	if [[ "$protocol" == "ssh" ]]; then
		git -C "$path" remote set-url --push origin "$ssh_url"
	else
		git -C "$path" config --unset-all remote.origin.pushurl >/dev/null 2>&1 || true
	fi
}

sync_one() {
	local name="$1"
	local path branch private allow_deployed parent temporary
	local https_url
	path="$(component_path "$name")"
	branch="$(component_value "$name" '.repo.branch')"
	private="$(component_value "$name" '(.repo.private // false)')"
	allow_deployed="$(component_value "$name" '(.repo.allowDeployed // false)')"
	https_url="$(github_urls "$name" | sed -n '1p')"

	if git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
		printf '%b✓%b %-24s %bpresent%b (%s)\n' \
			"$C_GREEN" "$C_RESET" "$name" "$C_DIM" "$C_RESET" \
			"$(git -C "$path" branch --show-current || true)"
		return 0
	fi
	if [[ -e "$path" ]]; then
		if [[ "$allow_deployed" == "true" && -d "$path" ]]; then
			printf '%b●%b %-24s %bdeployed/non-Git tree present%b\n' \
				"$C_YELLOW" "$C_RESET" "$name" "$C_YELLOW" "$C_RESET"
			return 0
		fi
		if [[ -d "$path" && -z "$(find "$path" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
			rmdir "$path"
		else
			printf '%s exists but is not a Git repository: %s\n' "$name" "$path" >&2
			return 1
		fi
	fi

	parent="$(dirname "$path")"
	mkdir -p "$parent"
	temporary="$(mktemp -d "$parent/.${name}.clone.XXXXXX")"
	register_cleanup "$temporary"
	rmdir "$temporary"
	printf '%b→%b %-24s cloning %b%s%b (%b%s%b)\n' \
		"$C_CYAN" "$C_RESET" "$name" "$C_DIM" "$https_url" "$C_RESET" \
		"$C_MAGENTA" "$branch" "$C_RESET"
	if GIT_TERMINAL_PROMPT=0 git clone \
		--filter=blob:none --single-branch --branch "$branch" \
		"$https_url" "$temporary"; then
		mv "$temporary" "$path"
		set_push_protocol "$name" "$path"
		return 0
	fi

	rm -rf "$temporary"
	if [[ "$private" == "true" ]]; then
		cat >&2 <<EOF
$name is private and could not be cloned. The rest of the workspace is usable.
Copy a deployed $name tree into:
  $path
EOF
		return 0
	fi
	return 1
}

sync_selection() {
	local selector="$1"
	local name
	select_components "$selector" true
	for name in "${targets[@]}"; do
		sync_one "$name"
	done
}

check_update_one() {
	local name="$1"
	local path branch current
	path="$(component_path "$name")"
	branch="$(component_value "$name" '.repo.branch')"
	if ! git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
		if [[ "$(component_value "$name" '(.repo.allowDeployed // false)')" == "true" && -d "$path" ]]; then
			printf '%b●%b %-24s %bdeployed/non-Git tree; not updated%b\n' \
				"$C_YELLOW" "$C_RESET" "$name" "$C_YELLOW" "$C_RESET"
			return 0
		fi
		printf '%s is missing; run ws sync %s first\n' "$name" "$name" >&2
		return 1
	fi
	if [[ -n "$(git -C "$path" status --porcelain)" ]]; then
		printf '%s has local changes; refusing to update\n' "$name" >&2
		return 1
	fi
	current="$(git -C "$path" branch --show-current)"
	if [[ "$current" != "$branch" ]]; then
		printf '%s is on %s, expected %s; refusing to switch branches\n' \
			"$name" "${current:-detached HEAD}" "$branch" >&2
		return 1
	fi
}

fetch_update_one() {
	local name="$1"
	local path branch
	path="$(component_path "$name")"
	branch="$(component_value "$name" '.repo.branch')"
	if ! git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
		return 0
	fi
	printf '%b↓%b %-24s fetching %b%s%b\n' \
		"$C_CYAN" "$C_RESET" "$name" "$C_MAGENTA" "$branch" "$C_RESET"
	git -C "$path" fetch --prune origin \
		"refs/heads/$branch:refs/remotes/origin/$branch"
}

check_update_fast_forward() {
	local name="$1"
	local path branch remote_ref
	path="$(component_path "$name")"
	branch="$(component_value "$name" '.repo.branch')"
	if ! git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
		return 0
	fi
	remote_ref="refs/remotes/origin/$branch"
	if git -C "$path" merge-base --is-ancestor HEAD "$remote_ref" ||
		git -C "$path" merge-base --is-ancestor "$remote_ref" HEAD; then
		return 0
	fi
	printf '%s has diverged from origin/%s; no repositories were merged\n' \
		"$name" "$branch" >&2
	return 1
}

merge_update_one() {
	local name="$1"
	local path branch
	path="$(component_path "$name")"
	branch="$(component_value "$name" '.repo.branch')"
	if ! git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
		return 0
	fi
	git -C "$path" merge --ff-only "refs/remotes/origin/$branch"
}

update_selection() {
	local selector="$1"
	local name
	select_components "$selector" true
	for name in "${targets[@]}"; do
		check_update_one "$name"
	done
	# Fetch every selected remote before moving any worktree. A network failure
	# or divergence therefore cannot leave a half-updated workspace.
	for name in "${targets[@]}"; do
		fetch_update_one "$name"
	done
	for name in "${targets[@]}"; do
		check_update_fast_forward "$name"
	done
	for name in "${targets[@]}"; do
		merge_update_one "$name"
	done
}

lifecycle_selection() {
	local selector="$1"
	local name path
	select_components "$selector" true
	lifecycle_names=()
	lifecycle_paths=()
	for name in "${targets[@]}"; do
		path="$(component_path "$name")"
		git -C "$path" rev-parse --git-dir >/dev/null 2>&1 || continue
		lifecycle_names+=("$name")
		lifecycle_paths+=("$path")
	done
	# The workspace repository is coordinated last. Its src/ directory is
	# ignored, so component worktrees cannot accidentally be staged here.
	lifecycle_names+=("cognipilot_workspace")
	lifecycle_paths+=("$root")
}

commit_selection() {
	local selector="$1"
	local message="$2"
	local index name path branch repo_message
	local -a dirty_indices=()

	lifecycle_selection "$selector"
	for index in "${!lifecycle_names[@]}"; do
		name="${lifecycle_names[$index]}"
		path="${lifecycle_paths[$index]}"
		[[ -n "$(git -C "$path" status --porcelain)" ]] || continue
		branch="$(git -C "$path" branch --show-current)"
		if [[ -z "$branch" ]]; then
			printf '%s is detached; refusing to commit\n' "$name" >&2
			return 1
		fi
		dirty_indices+=("$index")
	done

	if ((${#dirty_indices[@]} == 0)); then
		printf '%b✓%b no local changes to commit\n' "$C_GREEN" "$C_RESET"
		return 0
	fi
	if [[ -z "$message" && ! -t 0 ]]; then
		printf 'ws commit needs -m MESSAGE when standard input is not interactive\n' >&2
		return 2
	fi

	for index in "${dirty_indices[@]}"; do
		name="${lifecycle_names[$index]}"
		path="${lifecycle_paths[$index]}"
		repo_message="$message"
		if [[ -z "$repo_message" ]]; then
			printf '%b[%s]%b\n' "$C_BOLD$C_CYAN" "$name" "$C_RESET"
			git -C "$path" status --short
			read -r -p "commit message (empty skips): " repo_message
			if [[ -z "$repo_message" ]]; then
				printf '%b○%b %-24s skipped\n' "$C_DIM" "$C_RESET" "$name"
				continue
			fi
		fi
		git -C "$path" add -A
		if git -C "$path" diff --cached --quiet; then
			printf '%b○%b %-24s nothing staged\n' "$C_DIM" "$C_RESET" "$name"
			continue
		fi
		printf '%b→%b %-24s committing on %b%s%b\n' \
			"$C_CYAN" "$C_RESET" "$name" "$C_GREEN" \
			"$(git -C "$path" branch --show-current)" "$C_RESET"
		git -C "$path" commit -m "$repo_message"
	done
}

push_selection() {
	local selector="$1"
	local index name path branch upstream ahead temporary
	local failed=0
	local -a push_indices=() pids=() logs=()

	lifecycle_selection "$selector"
	for index in "${!lifecycle_names[@]}"; do
		name="${lifecycle_names[$index]}"
		path="${lifecycle_paths[$index]}"
		branch="$(git -C "$path" branch --show-current)"
		if [[ -z "$branch" ]]; then
			printf '%s is detached; refusing to push\n' "$name" >&2
			return 1
		fi
		if ! git -C "$path" remote get-url --push origin >/dev/null 2>&1; then
			printf '%s has no origin push URL\n' "$name" >&2
			return 1
		fi
		upstream="$(git -C "$path" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || true)"
		if [[ -n "$upstream" ]]; then
			ahead="$(git -C "$path" rev-list --count "$upstream"..HEAD)"
			((ahead > 0)) || continue
			if ! git -C "$path" merge-base --is-ancestor "$upstream" HEAD; then
				printf '%s has diverged from %s; refusing to push\n' "$name" "$upstream" >&2
				return 1
			fi
		fi
		push_indices+=("$index")
	done

	if ((${#push_indices[@]} == 0)); then
		printf '%b✓%b no local commits to push\n' "$C_GREEN" "$C_RESET"
		return 0
	fi

	temporary="$(mktemp -d)"
	register_cleanup "$temporary"
	for index in "${push_indices[@]}"; do
		name="${lifecycle_names[$index]}"
		path="${lifecycle_paths[$index]}"
		branch="$(git -C "$path" branch --show-current)"
		log="$temporary/$index.log"
		logs+=("$log")
		printf '%b↑%b %-24s pushing %b%s%b\n' \
			"$C_CYAN" "$C_RESET" "$name" "$C_MAGENTA" "$branch" "$C_RESET"
		(
			git -C "$path" push --set-upstream origin \
				"HEAD:refs/heads/$branch"
		) >"$log" 2>&1 &
		pids+=("$!")
	done

	for index in "${!pids[@]}"; do
		name="${lifecycle_names[${push_indices[$index]}]}"
		if wait "${pids[$index]}"; then
			printf '%b✓%b %-24s pushed\n' "$C_GREEN" "$C_RESET" "$name"
		else
			printf '%b✗%b %-24s push failed\n' "$C_RED" "$C_RESET" "$name" >&2
			sed 's/^/  /' "${logs[$index]}" >&2
			failed=1
		fi
	done
	rm -rf "$temporary"
	return "$failed"
}

check_selection_present() {
	local selector="$1"
	local with_dependencies="$2"
	local name path allow_deployed
	local -a missing=()
	select_components "$selector" "$with_dependencies"
	for name in "${targets[@]}"; do
		path="$(component_path "$name")"
		allow_deployed="$(component_value "$name" '(.repo.allowDeployed // false)')"
		if git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
			continue
		fi
		if [[ "$allow_deployed" == "true" && -d "$path" ]]; then
			continue
		fi
		missing+=("$name")
	done
	if ((${#missing[@]} > 0)); then
		printf 'missing workspace repositories: %s\n' "${missing[*]}" >&2
		printf 'run: ws sync %s\n' "$selector" >&2
		return 1
	fi
}

freeze_workspace() {
	local output="$1"
	local allow_unpushed="$2"
	local include_optional="$3"
	local temporary next output_temporary name path revision branch github optional
	local -a missing=()
	require_manifest
	[[ "$output" = /* ]] || output="$root/$output"
	temporary="$(mktemp)"
	register_cleanup "$temporary"
	next="$temporary.next"
	register_cleanup "$next"
	jq -n '{schema: 1, components: {}}' >"$temporary"

	while IFS= read -r name; do
		path="$(component_path "$name")"
		optional="$(component_value "$name" '.optional')"
		if [[ "$optional" == "true" && "$include_optional" != "true" ]]; then
			continue
		fi
		if ! git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
			if [[ "$optional" == "true" ]]; then
				continue
			fi
			missing+=("$name")
			continue
		fi
		if [[ -n "$(git -C "$path" status --porcelain)" ]]; then
			printf '%s has uncommitted changes; refusing to freeze\n' "$name" >&2
			return 1
		fi
		revision="$(git -C "$path" rev-parse HEAD)"
		if [[ "$allow_unpushed" != "true" ]] &&
			! git -C "$path" for-each-ref --contains "$revision" \
				--format='%(refname)' refs/remotes/origin/ | grep -q .; then
			printf '%s commit %s is not in a local origin tracking ref\n' \
				"$name" "$revision" >&2
			printf 'push it first, or use ws freeze --allow-unpushed\n' >&2
			return 1
		fi
		branch="$(component_value "$name" '.repo.branch')"
		github="$(component_value "$name" '.repo.github')"
		jq --arg name "$name" --arg path "${path#"$root"/}" \
			--arg github "$github" --arg branch "$branch" \
			--arg revision "$revision" \
			'.components[$name] = {
        path: $path, github: $github, branch: $branch, revision: $revision
      }' "$temporary" >"$next"
		mv "$next" "$temporary"
	done < <(jq -r '.components | keys[]' "$manifest")

	if ((${#missing[@]} > 0)); then
		printf 'cannot freeze; missing required repositories: %s\n' \
			"${missing[*]}" >&2
		return 1
	fi
	mkdir -p "$(dirname "$output")"
	output_temporary="$(mktemp "$(dirname "$output")/.workspace-lock.XXXXXX")"
	register_cleanup "$output_temporary"
	jq -e -S \
		'select(.schema == 1 and ((.components | length) > 0))' \
		"$temporary" >"$output_temporary"
	mv "$output_temporary" "$output"
	printf '%b✓%b workspace snapshot written: %b%s%b\n' \
		"$C_GREEN" "$C_RESET" "$C_CYAN" "$output" "$C_RESET"
}

materialize_snapshot_one() {
	local name="$1"
	local revision="$2"
	local bundle_dir="$3"
	local path parent temporary https_url bundle fetched
	path="$(component_path "$name")"
	if git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
		return 0
	fi
	if [[ -e "$path" ]]; then
		if [[ -d "$path" && -z "$(find "$path" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
			rmdir "$path"
		else
			printf '%s exists but is not a Git repository: %s\n' "$name" "$path" >&2
			return 1
		fi
	fi

	parent="$(dirname "$path")"
	mkdir -p "$parent"
	temporary="$(mktemp -d "$parent/.${name}.restore.XXXXXX")"
	register_cleanup "$temporary"
	https_url="$(github_urls "$name" | sed -n '1p')"
	git -C "$temporary" init -q
	git -C "$temporary" remote add origin "$https_url"
	bundle="$bundle_dir/$name.bundle"
	if [[ -n "$bundle_dir" && -r "$bundle" ]]; then
		git -C "$temporary" fetch "$bundle" refs/heads/workspace-snapshot
	else
		git -C "$temporary" fetch --filter=blob:none --no-tags origin "$revision"
	fi
	fetched="$(git -C "$temporary" rev-parse FETCH_HEAD)"
	if [[ "$fetched" != "$revision" ]]; then
		printf '%s snapshot source resolved to %s, expected %s\n' \
			"$name" "$fetched" "$revision" >&2
		return 1
	fi
	git -C "$temporary" switch --detach FETCH_HEAD
	mv "$temporary" "$path"
	set_push_protocol "$name" "$path"
}

restore_workspace() {
	local input="$1"
	local bundle_dir="$2"
	local name github expected_github revision path bundle fetched
	local -a snapshot_names=()
	local -A restore_paths=()
	local -A restore_revisions=()
	require_manifest
	[[ "$input" = /* ]] || input="$root/$input"
	[[ -r "$input" ]] || {
		printf 'snapshot not found: %s\n' "$input" >&2
		return 1
	}
	jq -e '.schema == 1 and (.components | type == "object")' "$input" >/dev/null || {
		printf 'unsupported workspace snapshot: %s\n' "$input" >&2
		return 1
	}
	while IFS= read -r name; do
		if ! jq -e --arg name "$name" '.components[$name] != null' "$input" >/dev/null; then
			printf 'snapshot is missing required component: %s\n' "$name" >&2
			return 1
		fi
	done < <(
		jq -r '.components | to_entries[]
      | select(.value.optional == false) | .key' "$manifest"
	)

	mapfile -t snapshot_names < <(jq -r '.components | keys[]' "$input")

	# First materialize and validate every repository. Existing worktrees are
	# not moved by sync_one.
	for name in "${snapshot_names[@]}"; do
		require_component "$name"
		github="$(jq -er --arg name "$name" '.components[$name].github' "$input")"
		expected_github="$(component_value "$name" '.repo.github')"
		if [[ "$github" != "$expected_github" ]]; then
			printf '%s snapshot repository changed: %s != %s\n' \
				"$name" "$github" "$expected_github" >&2
			return 1
		fi
		revision="$(jq -er --arg name "$name" '.components[$name].revision' "$input")"
		if [[ ! "$revision" =~ ^[0-9a-fA-F]{40}$ ]]; then
			printf '%s has an invalid snapshot revision: %s\n' "$name" "$revision" >&2
			return 1
		fi
		restore_revisions[$name]="$revision"
		materialize_snapshot_one "$name" "$revision" "$bundle_dir"
		path="$(component_path "$name")"
		restore_paths[$name]="$path"
		if ! git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
			printf '%s cannot be restored from a non-Git deployment\n' "$name" >&2
			return 1
		fi
	done

	# Resolve every commit and reject every dirty worktree before detaching any
	# repository, so a bad lock or unavailable object cannot partially restore.
	for name in "${snapshot_names[@]}"; do
		path="${restore_paths[$name]}"
		if [[ -n "$(git -C "$path" status --porcelain)" ]]; then
			printf '%s has local changes; refusing to restore\n' "$name" >&2
			return 1
		fi
		revision="${restore_revisions[$name]}"
		if ! git -C "$path" cat-file -e "$revision^{commit}" 2>/dev/null; then
			bundle="$bundle_dir/$name.bundle"
			if [[ -n "$bundle_dir" && -r "$bundle" ]]; then
				git -C "$path" fetch "$bundle" refs/heads/workspace-snapshot
				fetched="$(git -C "$path" rev-parse FETCH_HEAD)"
				[[ "$fetched" == "$revision" ]] || {
					printf '%s bundle resolved to %s, expected %s\n' \
						"$name" "$fetched" "$revision" >&2
					return 1
				}
			else
				git -C "$path" fetch origin "$revision"
			fi
		fi
	done

	for name in "${snapshot_names[@]}"; do
		path="${restore_paths[$name]}"
		revision="${restore_revisions[$name]}"
		git -C "$path" switch --detach "$revision"
		printf '%b✓%b %-24s %b%s%b\n' \
			"$C_GREEN" "$C_RESET" "$name" "$C_DIM" "$revision" "$C_RESET"
	done
}

usage() {
	cat <<'EOF'
Usage: ws <command> [arguments]

  sync COMPONENT|all    Clone missing repositories and local dependency closure
  update COMPONENT|all  Fetch and fast-forward clean configured branches
  commit [TARGET]       Commit changes in active repositories (default: all)
  push [TARGET]         Push local commits in parallel (default: all)
  freeze [FILE]         Record exact, clean, pushed core repository commits
  restore [FILE]        Restore exact commits; accepts --bundle-dir DIR
  mode [local|release]  Show or select dependency mode
  profile [NAME...]     Show or select one or more repository profiles
  profile list          List profiles, includes, and resolved components
  build [COMPONENT]     Build one component and its dependency closure
  test [COMPONENT]      Test one component and its dependency closure
  benchmark [COMPONENT...]  Record isolated cold and warm local build times
  shell COMPONENT       Enter the component's own pinned Nix shell
  launch [list|PROFILE...]  List or run composable supervised process profiles
  west sync             Update the one shared pinned west checkout
  west status           Show shared west paths and pin state
  west validate         Validate manifest compatibility without downloading
  west path             Print the selected shared west view path
  remotes [ssh|https]   Select local push protocol; fetch stays on HTTPS
  status [--all]        Show active repositories; --all shows every repository
  graph                 Print dependency edges from the component registry
  banner                Print the compact shell-entry status line

The default profile includes cubs2, which includes modelica. Other profiles
are cubs2, rdd2, modelica, zros, qualisys, ros2, ppm, and fastdyn; profiles may be
combined. Build and test never clone or update repositories. Freeze also accepts --allow-unpushed and
--include-optional.
EOF
}

command="${1:-help}"
shift || true

case "$command" in
help | -h | --help)
	usage
	;;
_complete)
	complete_workspace_command "$@"
	;;
sync)
	[[ $# -eq 1 ]] || {
		printf 'usage: ws sync COMPONENT|all\n' >&2
		exit 2
	}
	sync_selection "$1"
	;;
update)
	[[ $# -eq 1 ]] || {
		printf 'usage: ws update COMPONENT|all\n' >&2
		exit 2
	}
	update_selection "$1"
	;;
commit)
	selector="all"
	message=""
	selector_set=false
	while [[ $# -gt 0 ]]; do
		case "$1" in
		-m | --message)
			[[ $# -ge 2 ]] || {
				printf '%s needs a value\n' "$1" >&2
				exit 2
			}
			message="$2"
			shift
			;;
		-*)
			printf 'unknown commit option: %s\n' "$1" >&2
			exit 2
			;;
		*)
			[[ "$selector_set" == "false" ]] || {
				printf 'usage: ws commit [COMPONENT|all] [-m MESSAGE]\n' >&2
				exit 2
			}
			selector="$1"
			selector_set=true
			;;
		esac
		shift
	done
	if [[ "$selector" == "all" ]]; then
		require_manifest
	else
		require_component "$selector"
	fi
	commit_selection "$selector" "$message"
	;;
push)
	[[ $# -le 1 ]] || {
		printf 'usage: ws push [COMPONENT|all]\n' >&2
		exit 2
	}
	selector="${1:-all}"
	if [[ "$selector" == "all" ]]; then
		require_manifest
	else
		require_component "$selector"
	fi
	push_selection "$selector"
	;;
freeze)
	allow_unpushed=false
	include_optional=false
	output="workspace.lock.json"
	output_set=false
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--allow-unpushed) allow_unpushed=true ;;
		--include-optional) include_optional=true ;;
		-*)
			printf 'unknown freeze option: %s\n' "$1" >&2
			exit 2
			;;
		*)
			[[ "$output_set" == "false" ]] || {
				printf 'usage: ws freeze [--allow-unpushed] [--include-optional] [FILE]\n' >&2
				exit 2
			}
			output="$1"
			output_set=true
			;;
		esac
		shift
	done
	freeze_workspace "$output" "$allow_unpushed" "$include_optional"
	;;
restore)
	input="workspace.lock.json"
	bundle_dir=""
	input_set=false
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--bundle-dir)
			[[ $# -ge 2 ]] || {
				printf '%s needs a value\n' "$1" >&2
				exit 2
			}
			bundle_dir="$2"
			shift
			;;
		-*)
			printf 'unknown restore option: %s\n' "$1" >&2
			exit 2
			;;
		*)
			[[ "$input_set" == "false" ]] || {
				printf 'usage: ws restore [--bundle-dir DIR] [FILE]\n' >&2
				exit 2
			}
			input="$1"
			input_set=true
			;;
		esac
		shift
	done
	if [[ -n "$bundle_dir" && "$bundle_dir" != /* ]]; then
		bundle_dir="$root/$bundle_dir"
	fi
	restore_workspace "$input" "$bundle_dir"
	;;
mode)
	[[ $# -le 1 ]] || {
		printf 'usage: ws mode [local|release]\n' >&2
		exit 2
	}
	if [[ $# -eq 0 ]]; then
		current_mode
		exit 0
	fi
	case "$1" in
	local | release)
		state_write "$mode_file" "$1"
		if [[ "$1" == "local" ]]; then mode_color="$C_GREEN"; else mode_color="$C_YELLOW"; fi
		printf '%b✓%b workspace dependency mode: %b%s%b\n' \
			"$C_GREEN" "$C_RESET" "$mode_color" "$1" "$C_RESET"
		;;
	*)
		printf 'mode must be local or release\n' >&2
		exit 2
		;;
	esac
	;;
profile)
	if [[ $# -eq 0 ]]; then
		profile_label
		exit 0
	fi
	if [[ $# -eq 1 && "$1" == "list" ]]; then
		require_manifest
		while IFS= read -r profile_name; do
			includes="$(jq -r --arg profile "$profile_name" \
				'.profileDefinitions[$profile].includes | if length == 0 then "-" else join(", ") end' \
				"$manifest")"
			profile_components="$(jq -r --arg profile "$profile_name" \
				'.profiles[$profile] | join(", ")' "$manifest")"
			if current_profiles | grep -Fxq "$profile_name"; then
				printf '%b● %s%b %b(active)%b\n' \
					"$C_BOLD$C_CYAN" "$profile_name" "$C_RESET" "$C_GREEN" "$C_RESET"
			else
				printf '%b○ %s%b\n' "$C_DIM" "$profile_name" "$C_RESET"
			fi
			printf '  %bincludes:%b   %b%s%b\n' \
				"$C_BLUE" "$C_RESET" "$C_MAGENTA" "$includes" "$C_RESET"
			printf '  %bcomponents:%b %s\n' "$C_BLUE" "$C_RESET" "$profile_components"
		done < <(jq -r '.profiles | keys[]' "$manifest")
		exit 0
	fi
	profile_temporary="$(mktemp "$state/workspace-profile.XXXXXX")"
	register_cleanup "$profile_temporary"
	declare -A seen_profiles=()
	for profile_name in "$@"; do
		validate_profile "$profile_name"
		if [[ -z "${seen_profiles[$profile_name]:-}" ]]; then
			printf '%s\n' "$profile_name" >>"$profile_temporary"
			seen_profiles[$profile_name]=1
		fi
	done
	mv "$profile_temporary" "$profile_file"
	printf '%b✓%b workspace profiles: %b%s%b\n' \
		"$C_GREEN" "$C_RESET" "$C_CYAN" "$(profile_label)" "$C_RESET"
	printf '%brepository checkouts were not changed%b\n' "$C_DIM" "$C_RESET"
	;;
build | test)
	[[ $# -le 1 ]] || {
		printf 'usage: ws %s [COMPONENT|all]\n' "$command" >&2
		exit 2
	}
	mode="$(current_mode)"
	component="${1:-}"
	task_names=()
	if [[ -z "$component" || "$component" == "all" ]]; then
		selector="all"
		if [[ "$mode" == "local" ]]; then
			check_selection_present "$selector" true
		else
			check_selection_present "$selector" false
		fi
		select_components "$selector" false
		for selected_component in "${targets[@]}"; do
			if component_has_task "$selected_component" "$mode" "$command"; then
				task_names+=("$mode:$command:$selected_component")
			else
				printf '%b○%b %-24s no %s task declared\n' \
					"$C_DIM" "$C_RESET" "$selected_component" "$command"
			fi
		done
		if [[ "$mode" == "local" ]]; then
			select_build_components "$selector"
		fi
	else
		selector="$component"
		require_component "$component"
		if ! component_has_task "$component" "$mode" "$command"; then
			printf '%b○%b %s has no %s-mode %s task\n' \
				"$C_DIM" "$C_RESET" "$component" "$mode" "$command"
			exit 0
		fi
		task_names+=("$mode:$command:$component")
		if [[ "$mode" == "local" ]]; then
			check_selection_present "$selector" true
			select_build_components "$selector"
		else
			check_selection_present "$selector" false
		fi
	fi
	if ((${#task_names[@]} == 0)); then
		printf '%b○%b no %s tasks selected\n' "$C_DIM" "$C_RESET" "$command"
		exit 0
	fi
	if [[ -n "${selected[csyn_ros2_bridge]:-}" ]]; then
		require_ros_cache_trust
	fi
	cd "$root"
	COGNIPILOT_WORKSPACE_PROFILES="$(profiles_csv)"
	export COGNIPILOT_WORKSPACE_PROFILES
	mapfile -t devenv_args < <(devenv_profile_args "${targets[@]}")
	exec devenv "${devenv_args[@]}" tasks run "${task_names[@]}"
	;;
benchmark)
	exec "$root/scripts/benchmark-workspace" "$@"
	;;
shell)
	[[ $# -eq 1 ]] || {
		printf 'usage: ws shell COMPONENT\n' >&2
		exit 2
	}
	path="$(component_path "$1")"
	if [[ ! -d "$path" ]]; then
		printf '%s is not installed; run ws sync %s\n' "$1" "$1" >&2
		exit 1
	fi
	profile="$(component_value "$1" '(.devenvProfile // empty)')"
	if [[ -n "$profile" ]]; then
		cd "$root"
		# Expansion belongs in the nested shell.
		# shellcheck disable=SC2016
		exec devenv --profile "$profile" shell bash -c \
			'cd "$1"; exec "${SHELL:-bash}"' _ "$path"
	fi
	cd "$path"
	if [[ -f flake.nix ]]; then
		ref="$(workspace-flake-ref --mode local "$path")"
		exec nix --accept-flake-config develop "$ref"
	fi
	exec "${SHELL:-bash}"
	;;
launch)
	launch_workspace "$@"
	;;
west)
	subcommand="${1:-status}"
	shift || true
	if [[ ! -f "$root/src/cerebri_cubs2/west.yml" &&
		! -f "$root/src/cerebri_rdd2/west.yml" ]]; then
		printf 'west manifests are unavailable; run ws sync cerebri_cubs2 or ws sync cerebri_rdd2\n' >&2
		exit 1
	fi
	COGNIPILOT_WORKSPACE_PROFILES="$(profiles_csv)"
	export COGNIPILOT_WORKSPACE_PROFILES
	case "$subcommand" in
	sync | status | validate) exec workspace-west "$subcommand" "$@" ;;
	path) exec workspace-west path --mode "$(current_mode)" "$@" ;;
	*)
		printf 'usage: ws west {sync|status|validate|path}\n' >&2
		exit 2
		;;
	esac
	;;
remotes)
	require_manifest
	[[ $# -le 1 ]] || {
		printf 'usage: ws remotes [ssh|https]\n' >&2
		exit 2
	}
	if [[ $# -eq 0 ]]; then
		current_protocol
		exit 0
	fi
	protocol="$1"
	[[ "$protocol" == "ssh" || "$protocol" == "https" ]] || {
		printf 'usage: ws remotes {ssh|https}\n' >&2
		exit 2
	}
	while IFS= read -r name; do
		path="$(component_path "$name")"
		git -C "$path" rev-parse --git-dir >/dev/null 2>&1 || continue
		set_push_protocol "$name" "$path" "$protocol"
		printf '%b✓%b %-24s %bfetch=%b%s %bpush=%b%s\n' \
			"$C_GREEN" "$C_RESET" "$name" \
			"$C_BLUE" "$C_RESET" "$(git -C "$path" remote get-url origin)" \
			"$C_MAGENTA" "$C_RESET" "$(git -C "$path" remote get-url --push origin)"
	done < <(jq -r '.components | keys[]' "$manifest")
	state_write "$protocol_file" "$protocol"
	;;
status)
	require_manifest
	show_all=false
	if [[ $# -gt 1 || ($# -eq 1 && "$1" != "--all") ]]; then
		printf 'usage: ws status [--all]\n' >&2
		exit 2
	fi
	[[ $# -eq 1 ]] && show_all=true
	# Active status includes each selected profile's local dependency closure,
	# matching what sync/build/test operate on.
	select_components all true
	mode="$(current_mode)"
	if [[ "$mode" == "local" ]]; then mode_color="$C_GREEN"; else mode_color="$C_YELLOW"; fi
	printf '%bmode:%b     %b%s%b\n' \
		"$C_BOLD$C_BLUE" "$C_RESET" "$mode_color" "$mode" "$C_RESET"
	printf '%bprofiles:%b %b%s%b\n' \
		"$C_BOLD$C_BLUE" "$C_RESET" "$C_CYAN" "$(profile_label)" "$C_RESET"
	if [[ "$show_all" == "true" || -n "${selected[cerebri_cubs2]:-}" ||
		-n "${selected[cerebri_rdd2]:-}" ]] &&
		[[ -f "$root/src/cerebri_cubs2/west.yml" ||
			-f "$root/src/cerebri_rdd2/west.yml" ]]; then
		COGNIPILOT_WORKSPACE_PROFILES="$(profiles_csv)" workspace-west status
	elif [[ -n "${selected[cerebri_cubs2]:-}" ||
		-n "${selected[cerebri_rdd2]:-}" ]]; then
		printf 'west: not available until a firmware repository is synced\n'
	fi
	while IFS= read -r name; do
		if [[ -n "${selected[$name]:-}" ]]; then active=true; else active=false; fi
		if [[ "$show_all" != "true" && "$active" != "true" ]]; then
			continue
		fi
		path="$(component_path "$name")"
		memberships="$(jq -r --arg name "$name" \
			'[.profiles | to_entries[] | select(.value | index($name)) | .key] | join(",")' \
			"$manifest")"
		name_style="$C_BOLD$C_CYAN"
		if [[ "$active" == "true" ]] && component_is_active "$name"; then
			profile_state='active'
			profile_state_color="$C_DIM"
		elif [[ "$active" == "true" ]]; then
			profile_state='dependency'
			profile_state_color="$C_CYAN"
		else
			profile_state='inactive'
			profile_state_color="$C_DIM"
		fi
		if ! git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
			if [[ -d "$path" && "$(component_value "$name" '(.repo.allowDeployed // false)')" == "true" ]]; then
				printf '\n%b[%s]%b %b● deployed/non-Git tree%b\n' \
					"$name_style" "$name" "$C_RESET" "$C_YELLOW" "$C_RESET"
			elif [[ "$active" == "true" ]]; then
				printf '\n%b[%s]%b %b✗ missing%b\n' \
					"$name_style" "$name" "$C_RESET" "$C_RED" "$C_RESET"
				printf '  %bprofiles:%b %b%s%b %b(%s)%b\n' \
					"$C_BLUE" "$C_RESET" "$C_MAGENTA" "$memberships" "$C_RESET" \
					"$profile_state_color" "$profile_state" "$C_RESET"
				printf '  %brun: ws sync %s%b\n' "$C_YELLOW" "$name" "$C_RESET"
			else
				printf '\n%b[%s]%b %b○ not checked out%b\n' \
					"$name_style" "$name" "$C_RESET" "$C_DIM" "$C_RESET"
				printf '  %bprofiles:%b %b%s%b %b(%s)%b\n' \
					"$C_BLUE" "$C_RESET" "$C_MAGENTA" "$memberships" "$C_RESET" \
					"$profile_state_color" "$profile_state" "$C_RESET"
			fi
			continue
		fi
		branch="$(git -C "$path" branch --show-current)"
		revision="$(git -C "$path" rev-parse --short=12 HEAD)"
		if [[ -z "$branch" ]]; then
			branch_label="detached"
		else
			branch_label="$branch"
		fi
		branch_color="$C_DIM"
		if [[ -n "$(git -C "$path" status --porcelain)" ]]; then
			state_label='● dirty'
			state_color="$C_YELLOW"
		else
			state_label='✓ clean'
			state_color="$C_GREEN"
		fi
		printf '\n%b[%s]%b %b%s%b %b@ %s%b  %b%s%b\n' \
			"$name_style" "$name" "$C_RESET" \
			"$branch_color" "$branch_label" "$C_RESET" \
			"$C_DIM" "$revision" "$C_RESET" \
			"$state_color" "$state_label" "$C_RESET"
		printf '  %bprofiles:%b %b%s%b %b(%s)%b\n' \
			"$C_BLUE" "$C_RESET" "$C_MAGENTA" "$memberships" "$C_RESET" \
			"$profile_state_color" "$profile_state" "$C_RESET"
		upstream="$(git -C "$path" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || true)"
		if [[ -n "$upstream" ]]; then
			read -r ahead behind < <(
				git -C "$path" rev-list --left-right --count "HEAD...$upstream"
			)
			if ((ahead > 0)); then ahead_color="$C_YELLOW"; else ahead_color="$C_DIM"; fi
			if ((behind > 0)); then behind_color="$C_RED"; else behind_color="$C_DIM"; fi
			printf '  %bupstream:%b %s  %bahead %s%b  %bbehind %s%b\n' \
				"$C_BLUE" "$C_RESET" "$upstream" \
				"$ahead_color" "$ahead" "$C_RESET" \
				"$behind_color" "$behind" "$C_RESET"
		else
			printf '  %bupstream: none%b\n' "$C_YELLOW" "$C_RESET"
		fi
		print_worktree_status "$path"
	done < <(jq -r '.components | keys[]' "$manifest")
	;;
graph)
	require_manifest
	jq -r '
      . as $root
      | .components as $components
      | $components | to_entries[] as $component
      | ([$root.profiles | to_entries[]
          | select(.value | index($component.key)) | .key] | join(",")) as $profiles
      | if ($component.value.dependencies | length) == 0 then
          "\($component.key)"
        else
          $component.value.dependencies[]
          | "\(.) -> \($component.key)"
        end
        + "  [profiles: \($profiles)]"
    ' "$manifest"
	;;
banner)
	[[ $# -eq 0 ]] || {
		printf 'usage: ws banner\n' >&2
		exit 2
	}
	printf 'cognipilot_workspace (%s mode, %s profile) — run: ws help\n' \
		"$(current_mode)" "$(profile_label)"
	;;
*)
	printf 'unknown command: %s\n\n' "$command" >&2
	usage >&2
	exit 2
	;;
esac
