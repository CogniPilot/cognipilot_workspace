#!/bin/sh
set -eu

check=false
case "${1:-}" in
  "") ;;
  --check) check=true ;;
  -h|--help)
    printf '%s\n' 'Usage: ./setup [--check]'
    exit 0
    ;;
  *)
    printf 'setup: unknown option: %s\n' "$1" >&2
    exit 2
    ;;
esac

load_nix() {
  for profile in \
    /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh \
    "$HOME/.nix-profile/etc/profile.d/nix.sh"
  do
    if [ -r "$profile" ]; then
      # shellcheck disable=SC1090
      . "$profile"
      break
    fi
  done
}

command -v nix >/dev/null 2>&1 || load_nix
if ! command -v nix >/dev/null 2>&1; then
  command -v curl >/dev/null 2>&1 || {
    printf '%s\n' 'setup: curl is required to install Nix' >&2
    exit 1
  }
  curl --fail --location --proto '=https' --tlsv1.2 \
    https://nixos.org/nix/install | sh -s -- --daemon
  load_nix
fi

devenv_ref='github:cachix/devenv/407080febcc800abfd0fd688a0d513884aad620c'
if ! command -v devenv >/dev/null 2>&1 ||
  ! devenv version 2>/dev/null | grep -q '^devenv 2\.1\.3 '
then
  nix profile remove devenv >/dev/null 2>&1 || true
  nix profile add "$devenv_ref"
fi

if [ "$check" = true ]; then
  exec devenv test
fi

exec devenv shell
